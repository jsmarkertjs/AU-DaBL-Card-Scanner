[Unit]
Description=AU card reader -> Canvas tower light
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
# input = read the card reader via /dev/input; dialout = the tower light serial port
SupplementaryGroups=input dialout
WorkingDirectory=/opt/au-card-reader
# Optional file with CANVAS_TOKEN=... (see deploy/env.example)
EnvironmentFile=-/etc/au-card-reader/env
ExecStart=/usr/bin/python3 card_reader.py --config /etc/au-card-reader/config.ini
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
