[Unit]
Description=AU card reader -> Canvas tower light
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# root: the NeoPixel driver (rpi_ws281x) needs /dev/mem; root also covers the
# card reader (input), tower serial (dialout), audio, and the eInk SPI/GPIO.
User=root
WorkingDirectory=/opt/au-card-reader
# Optional file with CANVAS_TOKEN=... (see deploy/env.example)
EnvironmentFile=-/etc/au-card-reader/env
# Max out the USB audio card's mixer (it resets on replug/reboot).
ExecStartPre=-/opt/au-card-reader/deploy/audio-volume.sh
ExecStart=/usr/bin/python3 card_reader.py --config /etc/au-card-reader/config.ini
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
