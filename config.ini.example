[canvas]
url = https://american.instructure.com
# Leave blank and set the CANVAS_TOKEN env var instead (see deploy/env note).
token =
course_id =
# assignment_id = the Safety Waiver (must be graded); quiz_assignment_id = the
# Safety Quiz (must score >= quiz_passing_score).
assignment_id =
quiz_assignment_id =
quiz_passing_score = 9

[tower]
# "auto" finds the CH340 by USB VID. Or set an explicit port, e.g. /dev/ttyUSB0.
port = auto

[reader]
# Substring of the card reader's input device name. Blank = first keyboard-like
# device (fine on a headless Pi where the reader is the only one).
device_name =
# How long a result (green/red) stays before returning to idle yellow.
result_seconds = 6

[log]
# Append every swipe (timestamp + AUID) to a Google Sheet via an Apps Script
# web app. See the README for the one-time setup. Keep this file private.
enabled = false
url =
token =
timeout = 5

[audio]
# Play <dir>/<AUID>.mp3 (or .wav/.ogg) through the headphone jack when that
# card is swiped. Put files in Sounds/ named after the AUID (e.g. 5550363.mp3).
enabled = true
dir = Sounds
player = mpg123
volume = 80
# Extra player args if needed, e.g. "-o alsa" to force ALSA output.
player_args =
