[canvas]
url = https://american.instructure.com
# Leave blank and set the CANVAS_TOKEN env var instead (see deploy/env note).
token =
course_id =
# assignment_id = the Safety Waiver (must be graded); quiz_assignment_id = the
# Safety Quiz (must score >= quiz_passing_score).
assignment_id =
quiz_assignment_id =
quiz_passing_score = 9

[tower]
# "auto" finds the CH340 by USB VID. Or set an explicit port, e.g. /dev/ttyUSB0.
port = auto

[reader]
# Substring of the card reader's input device name. Blank = first keyboard-like
# device (fine on a headless Pi where the reader is the only one).
device_name =
# How long a result (green/red) stays before returning to idle yellow.
result_seconds = 6

[log]
# Append every swipe (timestamp + AUID) to a Google Sheet via an Apps Script
# web app. See the README for the one-time setup. Keep this file private.
enabled = false
url =
token =
timeout = 10

[audio]
# Play <dir>/<AUID>.mp3 (or .wav/.ogg) through the speaker when that card is
# swiped. Put files in Sounds/ named after the AUID (e.g. 5550363.mp3).
enabled = true
dir = Sounds
player = mpg123
volume = 80
# Output device. auto = prefer a USB speaker, else the headphone jack (works
# whichever is plugged in); or set an explicit ALSA device (e.g. plughw:1,0)
# or "none" to use the player's default.
device = auto
# Extra player args if needed, e.g. "-o alsa" to force ALSA output.
player_args =

[display]
# Adafruit 2.13" mono eInk FeatherWing (#4195, SSD1680) status screen. Shows an
# idle prompt and the result of each swipe. Needs SPI enabled and the
# EPD/Blinka libraries (deploy/install.sh handles both). See docs/eink-display.md.
# If it isn't wired up, the app warns once and keeps running.
enabled = true
# Blinka pin names (CE0/D22...) or plain BCM numbers. These match the default
# wiring in docs/eink-display.md: CS->GPIO8/CE0, DC->GPIO22, RST->GPIO13.
cs = CE0
dc = D22
rst = D13
# Leave blank: the optional BUSY pad isn't wired, so a fixed delay is used.
busy =
idle_text = Swipe your AU card
subtitle = Design & Build Lab

[neotower]
# NeoPixel tower: 4 strips x 9 LEDs (36 total) chained on one data line, driven
# directly from the Pi. Mirrors the tower-light states; idle is a rainbow flow.
# See docs/neotower.md. Needs rpi_ws281x and the service running as root.
enabled = true
pin = D18             # Blinka name or BCM number (GPIO18 = physical pin 12)
count = 36            # total LEDs in the chain
leds_per_strip = 9    # 3 green, 3 yellow, 3 red per strip
brightness = 80       # 0-255
order = RGB           # matches the strip's NEO_RGB
idle_seconds = 8      # one full rainbow cycle
